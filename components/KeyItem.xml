<?xml version="1.0" encoding="utf-8" ?>
<component name="KeyItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="refresh" />
        <field id="width" type="float" onChange="refresh" />
        <field id="height" type="float" onChange="refresh" />
        <field id="itemHasFocus" type="boolean" onChange="refresh" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/KeyItem.brs" />
    <children>
        <Rectangle id="bg" color="#2E1858" />
        <Poster id="icon" width="36" height="36" visible="false" />
        <Label id="label" horizAlign="center" vertAlign="center" font="font:MediumBoldSystemFont" color="#F6F0FF" />
    </children>
</component>
